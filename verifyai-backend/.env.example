# --- LLM / Search providers ---
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=tvly-your-tavily-key

# --- Supabase ---
# Project Settings -> API Keys ("Publishable" / "Secret"). Session JWTs are
# verified against Supabase's public JWKS endpoint (derived from SUPABASE_URL),
# not a static secret, so there's no JWT secret to set here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO

# --- Verification tuning ---
MAX_TEXT_LENGTH=50000
CHUNK_SIZE_CHARS=3000
MAX_CLAIMS_PER_CHUNK=8
MAX_EVIDENCE_PER_CLAIM=5
